                            <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Yazar Performans Karnesi</h2>
                            <p class="text-gray-500 font-medium">12 Aylık Gelişim & Etki Analizi</p>
                        </div>
                    </div>
                     <!-- Month Selector -->
                    <div class="bg-white p-2 rounded-lg shadow-sm border border-gray-200">
                        <label for="monthSelect" class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-1 px-1">Dönem Seçiniz</label>
                        <select id="monthSelect" onchange="updateDashboard(this.value)" class="block w-48 pl-3 pr-10 py-2 text-sm border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 rounded-md bg-gray-50 font-semibold text-gray-700">
                            <!-- Options populated by JS -->
                        </select>
                    </div>
                </div>
                
                 <!-- KPI Grid -->
                <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
                    <div class="bg-white p-5 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                        <div class="text-xs font-bold text-gray-400 uppercase tracking-wider">Toplam Etki</div>
                        <div class="text-2xl font-black text-blue-600 mt-1" id="val_impact">{val_impact:,.0f}</div>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                        <div class="text-xs font-bold text-gray-400 uppercase tracking-wider">Momentum Skoru</div>

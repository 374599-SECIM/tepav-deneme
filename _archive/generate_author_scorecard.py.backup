                        <div class="text-xs font-bold text-gray-400 uppercase tracking-wider">Profil Çekimi</div>
                        <div class="text-2xl font-black text-pink-600 mt-1" id="val_magnetism">{val_mag:,.0f}</div>
                        <div class="text-[10px] text-pink-400 font-medium mt-1">BİYOGRAFİ TRAFİĞİ</div>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                        <div class="text-xs font-bold text-gray-400 uppercase tracking-wider">Verimlilik</div>
                        <div class="text-2xl font-black text-green-600 mt-1" id="val_efficiency">{val_eff:.1f}</div>
                        <div class="text-[10px] text-gray-400 mt-1">GÖRÜNTÜLEME / YAZI</div>
                    </div>

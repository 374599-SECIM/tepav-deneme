                    </div>
                </div>
                
                <!-- Charts -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <!-- Radar -->
                    <div class="lg:col-span-5 bg-white p-4 rounded-2xl border border-gray-100 shadow-sm">
                        <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wide mb-4 text-center">Performans Dağılımı</h3>
                        <div id="radarChart" class="w-full h-64"></div>
                    </div>
                    <!-- Momentum Trend -->
                    <div class="lg:col-span-7 bg-white p-4 rounded-2xl border border-gray-100 shadow-sm">
                        <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wide mb-4 text-center">Momentum Trendi (Son 1 Yıl)</h3>
                        <div id="momentumChart" class="w-full h-64"></div>
                    </div>
                </div>
            </div>
            
            <script>
                // Embedded Data
                var historyData = {history_json};
                var normData = {norm_json};
                
                // --- Logic ---
                // Populate Dropdown
                var monthSelect = document.getElementById('monthSelect');
                var months = Object.keys(historyData).sort();
                var latestMonth = months[months.length - 1];
                
                months.reverse().forEach(function(m) {{
                    var option = document.createElement("option");
                    option.value = m;
                    option.text = m;
                    if(m === latestMonth) option.selected = true;
                    monthSelect.appendChild(option);
                }});
                
                function updateDashboard(month) {{
                    var data = historyData[month];
                    var norm = normData[month];
                    if (!data) return;
                    
                    // Simple animate function could go here
                    document.getElementById('val_impact').innerText = new Intl.NumberFormat('en-US').format(data.total_impact);
                    document.getElementById('val_momentum').innerText = new Intl.NumberFormat('en-US').format(data.momentum);
                    document.getElementById('val_magnetism').innerText = new Intl.NumberFormat('en-US').format(data.profile_magnetism);
                    document.getElementById('val_efficiency').innerText = data.efficiency.toFixed(1);
                    document.getElementById('val_productivity').innerText = data.productivity;
                    
                    // Update Radar
                    // Check if chart exists
                    var chart = document.getElementById('radarChart');
                    if (chart && chart.data) {{
                         Plotly.restyle('radarChart', {{
                            r: [[norm.total_impact, norm.momentum, norm.profile_magnetism, norm.efficiency, norm.productivity, norm.consistency]]
                         }});
                    }}
                }}
                
                // Initialize Charts
                // RADAR
                var initialNorm = normData[latestMonth] || {{}};
                var radarData = [{{
                    type: 'scatterpolar',
                    r: [
                        initialNorm.total_impact || 0, 
                        initialNorm.momentum || 0, 
                        initialNorm.profile_magnetism || 0,
                        initialNorm.efficiency || 0,
                        initialNorm.productivity || 0,
                        initialNorm.consistency || 0
                    ],
                    theta: ['Etki', 'Momentum', 'Profil', 'Verimlilik', 'Üretkenlik', 'İstikrar'],
                    fill: 'toself',
                    line: {{color: '#2563eb'}},
                    hovertemplate: 'Skor: %{{r:.1f}}<extra></extra>'
                }}];
                
                var radarLayout = {{
                    polar: {{
                        radialaxis: {{ visible: true, range: [0, 100], showticklabels: false }}
                    }},
                    margin: {{ t: 20, b: 20, l: 30, r: 30 }},
                    height: 250,
                    showlegend: false
                }};
                Plotly.newPlot('radarChart', radarData, radarLayout, {{displayModeBar: false}});
                
                // MOMENTUM LINE
                // We need the momentum history for the selected month? No, usually trend is static history or updates?
                // The user wants "Momentum Score Line Grafiği".
                // Let's show the full history curve we calculated in 'mom_dates'/values earlier?
                // But row data structure is different now. We can extract momentum from historyData keys.
                
                var momDates = Object.keys(historyData).sort();
                var momValues = momDates.map(m => historyData[m].momentum);
                
                var momTrace = {{
                    x: momDates,
                    y: momValues,
                    type: 'scatter',
                    mode: 'lines+markers',
                    line: {{color: '#9333ea', shape: 'spline', width: 3}},
                    marker: {{size: 6, color: '#FFFFFF', line: {{color: '#9333ea', width: 2}}}}
                }};
                
                var momLayout = {{
                    margin: {{ t: 10, b: 30, l: 40, r: 10 }},
                    height: 250,
                    xaxis: {{ showgrid: false, tickformat: '%Y-%m', nticks: 5 }},
                    yaxis: {{ showgrid: true, gridcolor: '#f3f4f6' }},
                    showlegend: false
                }};
                Plotly.newPlot('momentumChart', [momTrace], momLayout, {{displayModeBar: false}});
                
            </script>
            <!-- END SCORECARD MODULE -->
            """
            
            # --- Merge Logic ---
            target_filename = f"tr_ekibimiz_s_{row['id']}.html"
            target_path = os.path.join(self.output_dir, target_filename)
            
            merged = False
            if os.path.exists(target_path):
                try:
                    with open(target_path, 'r', encoding='utf-8') as f:
                        content = f.read()
                    
                    # 1. Inject Tailwind if not present
                    if "tailwindcss" not in content:
                        content = content.replace("</head>", '<script src="https://cdn.tailwindcss.com"></script>\n</head>')
                    
                    # 2. Update or Inject Scorecard
                    import re
                    if "<!-- TEPAV AUTHOR SCORECARD MODULE -->" in content:
                        # Replace existing (Robust replacement)
                        # We try to match from the start marker to either the end marker OR the start of the next section
                        pattern = r"<!-- TEPAV AUTHOR SCORECARD MODULE -->.*?(?:<!-- END SCORECARD MODULE -->|<div class='mt-12 mb-6 border-b pb-2'>)"
                        new_content = re.sub(pattern, scorecard_section, content, flags=re.DOTALL)
                        if new_content != content:
                            content = new_content
                            merged = True
                        else:
                            # Fallback if pattern didn't match perfectly
                            pass

                    if not merged and "<!-- KPI Kartları -->" in content:
                        # First time merge or fallback
                        insertion = scorecard_section + "\n<div class='mt-12 mb-6 border-b pb-2'><h3 class='text-2xl font-bold text-slate-800'>Sayfa Detay Raporu (Web Analitiği)</h3></div>\n"
                        content = content.replace("<!-- KPI Kartları -->", insertion + "<!-- KPI Kartları -->")
                        merged = True
                    
                    if merged:
                        # Save
                        with open(target_path, 'w', encoding='utf-8') as f:
                            f.write(content)
                except Exception as e:
                    print(f"Merge failed for {row['name']}: {e}")
            
            if not merged:
                # Standalone Fallback (if detail report doesn't exist)
                print(f"Notice: Creating standalone scorecard for {row['name']} (Detail report not found)")
                html = f"""
                <!DOCTYPE html>
                <html>
                <head>
                    <meta charset="UTF-8">
                    <title>{row['name']} - Yazar Karnesi</title>
                    <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
                    <script src="https://cdn.tailwindcss.com"></script>
                    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
                    <style>body {{ font-family: 'Inter', sans-serif; }}</style>
                </head>
                <body class="bg-gray-50 text-slate-800">
                    <div class="max-w-7xl mx-auto px-4 py-8">
                        <a href="yazarlar_karsilastirma.html" class="text-blue-600 hover:underline mb-4 inline-block">&larr; Tüm Yazarlar</a>
                        {scorecard_section}
                    </div>
                </body>
                </html>
                """
                # Note: creating a new file or overwriting? 
                # If we are here, file didn't exist or read failed.
                with open(target_path, 'w', encoding='utf-8') as f:
                     f.write(html)
            else:
                # If merged, we need to make sure the format string in scorecard_section was applied
                # Wait, I used f-string for scorecard_section but it contains {history_json} placeholder inside? 
                # No, I used `var historyData = {history_json};` inside the f-string. 
                # This works if I format it.
                # BUT `scorecard_section` defined above has local variables {initials}, {val_impact} etc directly embedded via f-string.
                # However, {history_json} and {norm_json} are variables I defined just before.
                # So the f-string ALREADY interpolated them!
                # My logic `scorecard_section.format(...)` in the standalone block is WRONG because they are already formatted.
                # Correct: Just use `scorecard_section` variable.
                pass 
            

        # Generate Main Hub
        self.generate_hub(df_scores)

    def generate_hub(self, df):
        print("Generating Comparison Hub...")
        
        # Prepare Data for Hub JS
        # List of { id, name, history: { month: { scores... } } }
        hub_data = []
        for _, row in df.iterrows():
            hub_data.append({
                'id': row['id'],
                'name': row['name'],
                'filename': row.get('filename', f"tr_ekibimiz_s_{row['id']}.html"),
                'history': row['metrics_history']
            })
            
        hub_json = json.dumps(hub_data)
        
        html = f"""
        <!DOCTYPE html>
        <html>
        <head>
            <meta charset="UTF-8">
            <title>Yazar Analiz Merkezi - TEPAV</title>
            <script src="https://cdn.tailwindcss.com"></script>
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
            <style>body {{ font-family: 'Inter', sans-serif; }}</style>
        </head>
        <body class="bg-gray-50 text-slate-800">
            <div class="max-w-6xl mx-auto px-4 py-12">
            <!-- Navigation -->
            <div class="flex justify-start mb-6">
                <a href="../index.html" class="flex items-center text-blue-600 hover:text-blue-800 transition font-semibold">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                    </svg>
                    Canlı Panel'e Dön
                </a>
            </div>
            <div class="mb-10 text-center">
                <h1 class="text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-indigo-600 mb-4">Yazar Analiz Merkezi</h1>
                    <p class="text-xl text-gray-500 mb-8">Performans Metrikleri ve Karşılaştırma Tablosu</p>
                    
                    <div class="flex justify-center space-x-4 mb-8">
                         <!-- Search Bar -->
                        <div class="relative w-96">
                            <input type="text" id="authorSearch" placeholder="Yazar ara..." 
                                class="w-full px-6 py-4 rounded-full border border-gray-200 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-lg"
                                onkeyup="renderTable()">
                            <div class="absolute right-4 top-4 text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                            </div>
                        </div>
                        
                        <!-- Month Selector -->
                        <div class="relative">
                            <select id="monthSelect" onchange="renderTable()" class="h-full px-6 py-4 rounded-full border border-gray-200 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white text-lg cursor-pointer appearance-none pr-12">
                                <!-- Populated by JS -->
                            </select>
                            <div class="absolute right-4 top-1/2 transform -translate-y-1/2 pointer-events-none text-gray-500">▼</div>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse" id="authorTable">
                            <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider text-xs">
                                <tr>
                                    <th class="py-4 px-6 font-semibold cursor-pointer hover:text-blue-600" onclick="sortTable('name')">Yazar</th>
                                    <th class="py-4 px-6 text-right font-semibold cursor-pointer hover:text-blue-600" onclick="sortTable('momentum')">Momentum Skoru ⚡</th>
                                    <th class="py-4 px-6 text-right font-semibold cursor-pointer hover:text-blue-600" onclick="sortTable('profile_magnetism')">Profil Çekimi 🧲</th>
                                    <th class="py-4 px-6 text-right font-semibold cursor-pointer hover:text-blue-600" onclick="sortTable('total_impact')">Toplam Etki</th>
                                    <th class="py-4 px-6 text-right font-semibold cursor-pointer hover:text-blue-600" onclick="sortTable('productivity')">Yazı Sayısı</th>
                                    <th class="py-4 px-6 text-right font-semibold cursor-pointer hover:text-blue-600" onclick="sortTable('efficiency')">Verimlilik</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                <!-- Populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <script>
                var authors = {hub_json};
                var currentSort = 'momentum';
                var sortAsc = false;
                
                // Init Month Selector
                var monthSelect = document.getElementById('monthSelect');
                if (authors.length > 0) {{
                    var months = Object.keys(authors[0].history).sort();
                    var latest = months[months.length - 1];
                    
                    months.reverse().forEach(function(m) {{
                        var opt = document.createElement("option");
                        opt.value = m;
                        opt.text = m;
                        if (m === latest) opt.selected = true;
                        monthSelect.appendChild(opt);
                    }});
                }}
                
                function sortTable(key) {{
                    if (currentSort === key) {{
                        sortAsc = !sortAsc;
                    }} else {{
                        currentSort = key;
                        sortAsc = false; // Default desc for metrics
                        if (key === 'name') sortAsc = true;
                    }}
                    renderTable();
                }}
                
                function renderTable() {{
                    var month = document.getElementById('monthSelect').value;
                    var search = document.getElementById('authorSearch').value.toUpperCase();
                    var tbody = document.getElementById('tableBody');
                    tbody.innerHTML = '';
                    
                    // Filter and Sort
                    var filtered = authors.filter(function(a) {{
                        return a.name.toUpperCase().indexOf(search) > -1;
                    }});
                    
                    filtered.sort(function(a, b) {{
                        var k = currentSort;
                        var vA, vB;
                        
                        if (k === 'name') {{
                            vA = a.name; vB = b.name;
                        }} else {{
                            vA = a.history[month] ? a.history[month][k] : 0;
                            vB = b.history[month] ? b.history[month][k] : 0;
                        }}
                        
                        if (vA < vB) return sortAsc ? -1 : 1;
                        if (vA > vB) return sortAsc ? 1 : -1;
                        return 0;
                    }});
                    
                    filtered.forEach(function(a) {{
                        var data = a.history[month];
                        if (!data) return;
                        
                        var tr = document.createElement('tr');
                        tr.className = "border-b border-gray-100 hover:bg-blue-50 transition-colors cursor-pointer";
                        tr.onclick = function() {{ window.location = a.filename; }};
                        
                        tr.innerHTML = `
                            <td class="py-4 px-6 font-medium text-blue-600 hover:underline"><a href="${{a.filename}}">${{a.name}}</a></td>
                            <td class="py-4 px-6 text-right font-bold text-gray-800">${{new Intl.NumberFormat('en-US').format(data.momentum)}}</td>
                            <td class="py-4 px-6 text-right font-bold text-pink-600">${{new Intl.NumberFormat('en-US').format(data.profile_magnetism)}}</td>
                            <td class="py-4 px-6 text-right text-gray-600">${{new Intl.NumberFormat('en-US').format(data.total_impact)}}</td>
                            <td class="py-4 px-6 text-right text-gray-600">${{data.productivity}}</td>
                            <td class="py-4 px-6 text-right text-gray-600">${{data.efficiency.toFixed(1)}}</td>
                        `;
                        tbody.appendChild(tr);
                    }});
                }}
                
                // Initial Render
                renderTable();
            </script>
        </body>
        </html>
        """
        
        with open(os.path.join(self.output_dir, "yazarlar_karsilastirma.html"), "w", encoding="utf-8") as f:
            f.write(html)

def main():
    gen = AuthorScorecardGenerator()
    mapping = gen.load_mapping()
    if mapping is None: 
        return
        
    analytics_data = gen.load_or_fetch_data()
    if analytics_data.empty:
        print("No analytics data found.")
        return
        
    scores = gen.calculate_scores(mapping, analytics_data)
    gen.generate_htmls(scores)
    print("Done!")

if __name__ == "__main__":
    main()

   "source": [
    "import requests\n",
    "\n",
    "url = \"https://www.tepav.org.tr/tr\"\n",
    "\n",
    "response = requests.get(url, timeout=20)\n",
    "response.raise_for_status()  # Hata varsa durdurur\n",
    "\n",
    "with open(\"tepav_tr.html\", \"w\", encoding=\"utf-8\") as f:\n",
    "    f.write(response.text)\n",
    "\n",
    "print(\"İndirildi: tepav_tr.html\")\n"
   ]
  }
 ],
